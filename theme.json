{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,

	"settings": {
		"appearanceTools": true,

		"layout": {
			"contentSize": "1200px",
			"wideSize": "1440px"
		},

		"color": {
			"defaultPalette": false,
			"palette": [
				{
					"slug": "primary",
					"color": "#2563EB",
					"name": "Primary"
				},
				{
					"slug": "primary-dark",
					"color": "#1D4ED8",
					"name": "Primary Dark"
				},
				{
					"slug": "dark",
					"color": "#111827",
					"name": "Dark"
				},
				{
					"slug": "text",
					"color": "#374151",
					"name": "Text"
				},
				{
					"slug": "light",
					"color": "#F9FAFB",
					"name": "Light"
				},
				{
					"slug": "white",
					"color": "#FFFFFF",
					"name": "White"
				}
			]
		},

		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw",
				"vh"
			]
		},

		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "Inter, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"name": "Inter",
					"slug": "inter"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.25rem",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "2rem",
					"name": "Extra Large"
				},
				{
					"slug": "xx-large",
					"size": "clamp(2.5rem, 5vw, 4.5rem)",
					"name": "XX Large"
				}
			]
		}
	},

	"styles": {
		"color": {
			"background": "var:preset|color|white",
			"text": "var:preset|color|text"
		},

		"typography": {
			"fontFamily": "var:preset|font-family|inter",
			"fontSize": "1rem",
			"lineHeight": "1.6"
		},

		"spacing": {
			"blockGap": "1.5rem"
		},

		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.15"
				},
				"color": {
					"text": "var:preset|color|dark"
				}
			},

			"link": {
				"color": {
					"text": "var:preset|color|primary"
				},
				"typography": {
					"textDecoration": "none"
				}
			},

			"button": {
				"border": {
					"radius": "8px"
				},
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|white"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"right": "1.5rem",
						"bottom": "0.75rem",
						"left": "1.5rem"
					}
				},
				"typography": {
					"fontWeight": "600"
				}
			}
		},

		"blocks": {
			"core/button": {
				"border": {
					"radius": "8px"
				}
			},

			"core/group": {
				"spacing": {
					"blockGap": "1.5rem"
				}
			},

			"core/columns": {
				"spacing": {
					"blockGap": "2rem"
				}
			}
		}
	}
}